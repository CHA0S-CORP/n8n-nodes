{
  "name": "n8n-nodes-govee",
  "version": "0.1.0",
  "description": "n8n community node to control Govee LEDs via Cloud API, LAN UDP, and the app AWS IoT (MQTT) channel",
  "keywords": [
    "n8n-community-node-package",
    "govee",
    "led",
    "smart-home"
  ],
  "license": "MIT",
  "author": "CHA0S-CORP",
  "homepage": "https://github.com/CHA0S-CORP/n8n-nodes/tree/main/packages/n8n-nodes-govee",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CHA0S-CORP/n8n-nodes.git",
    "directory": "packages/n8n-nodes-govee"
  },
  "bugs": {
    "url": "https://github.com/CHA0S-CORP/n8n-nodes/issues"
  },
  "engines": {
    "node": ">=18.10"
  },
  "main": "index.js",
  "scripts": {
    "build": "tsc && node ../../scripts/copy-icons.js",
    "dev": "tsc --watch",
    "format": "prettier nodes credentials --write",
    "lint": "eslint nodes credentials",
    "lintfix": "eslint nodes credentials --fix",
    "prepublishOnly": "npm run build && npm run lint"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/GoveeApi.credentials.js",
      "dist/credentials/GoveeApp.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Govee/Govee.node.js"
    ]
  },
  "dependencies": {
    "mqtt": "^5.10.1",
    "node-forge": "^1.3.1",
    "uuid": "^9.0.1"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/node-forge": "^1.3.11",
    "@types/uuid": "^9.0.8",
    "@typescript-eslint/parser": "^7.15.0",
    "eslint": "^8.57.0",
    "eslint-plugin-n8n-nodes-base": "^1.16.3",
    "n8n-workflow": "*",
    "prettier": "^3.3.2",
    "typescript": "^5.5.3"
  }
}
